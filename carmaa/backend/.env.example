CARMA_LAN_IP=127.0.0.1
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
REDIS_PASSWORD=replace-with-a-different-64-random-hex-characters
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Must be a same-site URL in production where possible.
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://carmaa:local-development-only@localhost:5432/carmaa
DATABASE_SSL=false
REDIS_URL=redis://:local-development-only@localhost:6379
# Generate two independent secrets, at least 32 random bytes each.
OTP_PEPPER=replace-with-at-least-32-random-bytes
SESSION_PEPPER=replace-with-a-different-at-least-32-random-bytes
# In production prefer __Host-carmaa_session (requires HTTPS and Secure cookie).
COOKIE_NAME=carmaa_session
COOKIE_SECURE=false
DEFAULT_PHONE_COUNTRY_CODE=98
# LOCAL TEST ONLY: use 123456 without sending SMS while NODE_ENV=development.
# Clear this value for real SMS testing; production startup refuses any non-empty value.
DEV_OTP_CODE=
# SMS: kavenegar (production).
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Zarinpal v4. Amounts configured in service catalog are in toman and converted to rial.
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/api/v1/payments/zarinpal/callback
# Set true only on local development, never for a real public deployment.
PAYMENT_SANDBOX=true
# Local file storage. Use an access-controlled S3-compatible bucket in production.
MEDIA_ROOT=./var/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Set to 1 only when app is behind a correctly configured trusted reverse proxy.
TRUST_PROXY=0
# Phones (E.164, comma-separated) that become admin automatically after a real OTP login / API start.
ADMIN_BOOTSTRAP_PHONES=+989965926283

# Automatic car news (RSS -> Persian via Claude API). Leave ANTHROPIC_API_KEY empty to keep only the built-in static news.
ANTHROPIC_API_KEY=
NEWS_AI_MODEL=claude-haiku-5-5
# Minutes between feed checks (0 = off)
NEWS_INGEST_MINUTES=30
# "Name|https://feed-url" separated by commas
NEWS_FEEDS=KBB|https://www.kbb.com/car-news/feed/,Elektroquatsch|https://www.elektroquatsch.de/feed/
MELIPAYAMAK_ADV_URL=
MELIPAYAMAK_FROM=
